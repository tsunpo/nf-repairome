/*
========================================================================================
    nf-repairome: Configuration
========================================================================================
*/

params {
    // Pipeline Inputs (fall back to launch location if not provided via CLI)
    samplesheet  = params.samplesheet  ?: "Data1.tsv"
    fastq_dir    = params.fastq_dir    ?: "${launchDir}/fastq"
    outdir       = params.outdir       ?: "${launchDir}/data"

    // Static code assets (anchored to the Git repository root where main.nf lives)
    code_dir     = "${projectDir}"
    bt2_index    = "${params.code_dir}/index/guides_ext"
    scripts_dir  = "${params.code_dir}/scripts"
}

profiles {
    slurm {
        process {
            executor       = 'slurm'
            clusterOptions = '--export=ALL'
            beforeScript   = 'source $HOME/miniforge3/etc/profile.d/conda.sh && conda activate repairome'

            // Default fallback resource settings
            cpus   = 2
            memory = '4 GB'
            time   = '2h'

            // Step 1: Guide alignment (Trimmomatic + Bowtie2)
            // Attempt 1: 6h | Attempt 2: 12h | Attempt 3: 18h
            withName: 'ALIGN_GUIDES_R1' {
                cpus   = 8
                memory = '16 GB'
                time   = { 6.h * task.attempt }
                maxRetries = 2
                errorStrategy = { task.exitStatus in [125, 137, 140] ? 'retry' : 'finish' }
            }

            // Step 2: Indel analysis (Python ScarMapper on chunks)
            // Attempt 1: 24h | Attempt 2: 48h
            withName: 'ANALYSIS_INDELS_R2' {
                cpus   = 6
                memory = '32 GB'
                time   = { 24.h * task.attempt }
                maxRetries = 1
                errorStrategy = { task.exitStatus in [125, 137, 140] ? 'retry' : 'finish' }
            }

            // Step 3: Matrix generation
            // Attempt 1: 2h | Attempt 2: 4h | Attempt 3: 6h
            withName: 'CREATE_MATRIX' {
                cpus   = 2
                memory = '16 GB'
                time   = { 2.h * task.attempt }
                maxRetries = 2
                errorStrategy = { task.exitStatus in [125, 137, 140] ? 'retry' : 'finish' }
            }
        }

        executor {
            queueSize       = 20
            submitRateLimit = '5/1sec'
        }
    }
}