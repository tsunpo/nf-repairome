params {
    // Default runtime parameters
    samplesheet  = "Data1.tsv"
    fastq_dir    = "./fastq"
    outdir       = "./data"

    // Repository root & asset paths
    code_dir     = "${projectDir}"
    bt2_index    = "${params.code_dir}/index/guides_ext"
    scripts_dir  = "${params.code_dir}/scripts"
}

profiles {
    slurm {
        conda.enabled          = true
        process.executor       = 'slurm'
        process.conda          = 'repairome'
        process.clusterOptions = '--export=ALL'

        process {
            withName: 'ALIGN_GUIDES_R1' {
                cpus   = 8
                memory = 16.GB
                time   = '2h'
            }
            withName: 'ANALYSIS_INDELS_R2' {
                cpus   = 8
                memory = 16.GB
                time   = '4h'
            }
            withName: 'CREATE_MATRIX' {
                cpus   = 2
                memory = 8.GB
                time   = '1h'
            }
        }
    }

    local {
        conda.enabled    = true
        process.executor = 'local'
        process.conda    = 'repairome'
    }
}