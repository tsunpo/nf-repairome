params {
    samplesheet  = "Data1.tsv"
    fastq_dir    = "./fastq"
    outdir       = "./data"
    code_dir     = "/storage/scratch01/users/tpyang/dev/nf-repairome"
    bt2_index    = "${code_dir}/index/guides_ext"
    scripts_dir  = "${code_dir}/scripts"
}

profiles {
    slurm {
        process {
            executor       = 'slurm'
            conda          = 'repairome'
            clusterOptions = '--export=ALL'

            withName: ALIGN_GUIDES_R1 {
                cpus   = 8
                memory = 16.GB
                time   = '2h'
            }
            withName: ANALYSIS_INDELS_R2 {
                cpus   = 8
                memory = 16.GB
                time   = '4h'
            }
            withName: CREATE_MATRIX {
                cpus   = 2
                memory = 8.GB
                time   = '1h'
            }
        }
    }
    local {
        process.executor = 'local'
        process.conda    = 'repairome'
    }
}