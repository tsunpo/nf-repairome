params {
    // Pipeline Inputs
    samplesheet  = "Data1.tsv"
    fastq_dir    = "/storage/scratch01/users/tpyang/tdb/repairome/fastq"
    outdir       = "/storage/scratch01/users/tpyang/tdb/repairome/data"

    // Repository root & asset paths
    code_dir     = "${projectDir}"
    bt2_index    = "${params.code_dir}/index/guides_ext"
    scripts_dir  = "${params.code_dir}/scripts"
}

profiles {
    slurm {
        process {
            executor       = 'slurm'
            clusterOptions = '--export=ALL'
            beforeScript   = 'source $HOME/miniforge3/etc/profile.d/conda.sh && conda activate repairome'
        }
    }
}